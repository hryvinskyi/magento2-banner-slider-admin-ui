<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::content">
                    <resource id="Hryvinskyi_BannerSlider::banner_slider" title="Banner Slider" translate="title"
                              sortOrder="50">
                        <resource id="Hryvinskyi_BannerSlider::slider" title="Manage Sliders" translate="title"
                                  sortOrder="10">
                            <resource id="Hryvinskyi_BannerSlider::slider_save" title="Save Slider"
                                      translate="title" sortOrder="10"/>
                            <resource id="Hryvinskyi_BannerSlider::slider_delete" title="Delete Slider"
                                      translate="title" sortOrder="20"/>
                        </resource>
                        <resource id="Hryvinskyi_BannerSlider::banner" title="Manage Banners" translate="title"
                                  sortOrder="20">
                            <resource id="Hryvinskyi_BannerSlider::banner_save" title="Save Banner"
                                      translate="title" sortOrder="10"/>
                            <resource id="Hryvinskyi_BannerSlider::banner_delete" title="Delete Banner"
                                      translate="title" sortOrder="20"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Hryvinskyi_BannerSlider::config" title="Banner Slider Configuration"
                                      translate="title" sortOrder="50"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
