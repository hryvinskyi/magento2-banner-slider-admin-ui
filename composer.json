{
    "name": "hryvinskyi/magento2-banner-slider-admin-ui",
    "description": "Banner Slider admin module: slider and banner grids and forms, responsive crop editor, uploads, ACL, menu and configuration",
    "type": "magento2-module",
    "version": "2.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "Volodymyr Hryvinskyi",
            "email": "volodymyr@hryvinskyi.com"
        }
    ],
    "require": {
        "php": "~8.3.0||~8.4.0",
        "hryvinskyi/magento2-banner-slider": "^2.1",
        "hryvinskyi/magento2-banner-slider-api": "^2.1",
        "hryvinskyi/magento2-base": "^2.2",
        "hryvinskyi/magento2-configuration-fields": "^1.0.10",
        "magento/framework": "^103.0.7",
        "magento/module-backend": "^102.0",
        "magento/module-config": "^101.2",
        "magento/module-customer": "^103.0",
        "magento/module-store": "^101.1",
        "magento/module-ui": "^101.2",
        "psr/log": "^2.0 || ^3.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Hryvinskyi\\BannerSliderAdminUi\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hryvinskyi\\BannerSliderAdminUi\\Test\\": "Test/"
        }
    },
    "archive": {
        "exclude": [
            "/Test"
        ]
    }
}
